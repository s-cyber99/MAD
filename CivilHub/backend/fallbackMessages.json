    "threadId": "thread_client_structural_1",
    "senderRole": "client",
    "engineerType": null,
    "senderName": "Client Salman",
    "text": "Engr. Tanvir, could you review column sizing and shear wall requirements for a 10-story tower under BNBC 2020 seismic zone 2?",
